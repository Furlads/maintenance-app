generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        Int             @id @default(autoincrement())
  name      String
  createdAt DateTime        @default(now())
  workers   WorkerCompany[]
}

model Worker {
  id                     Int                       @id @default(autoincrement())
  phone                  String?
  email                  String?
  active                 Boolean                   @default(true)
  createdAt              DateTime                  @default(now())
  accessLevel            String
  firstName              String
  jobTitle               String
  lastName               String
  pinHash                String?
  failedLoginAttempts    Int                       @default(0)
  lastLoginAt            DateTime?
  lockedUntil            DateTime?
  passwordHash           String?
  mustChangePassword     Boolean                   @default(false)
  assignedJobs           JobAssignment[]
  notes                  JobNote[]
  uploadedPhotos         JobPhoto[]
  timeOffRequests        TimeOffRequest[]
  webauthnCredentials    WebAuthnCredential[]
  availabilityBlocks     WorkerAvailabilityBlock[]
  companies              WorkerCompany[]
  chasMessages           ChasMessage[]
  jobAuditLogs           JobAuditLog[]
  activityLogs           ActivityLog[]
  employmentType         String                    @default("employee")
  dayRate                Float?
  skills                 String[]                  @default([])
  transportNotes         String?
  canDrive               Boolean                   @default(true)
  transportRequired      Boolean                   @default(false)
  canUseCompanyTools     Boolean                   @default(false)
  canUseCompanyVehicle   Boolean                   @default(false)
  cisRegistered          Boolean                   @default(false)
  cisVerified            Boolean                   @default(false)
  cisVerificationNumber  String?
  cisDeductionRate       Float?
  workAcceptanceRequired Boolean                   @default(false)
  tradingName            String?
  utrNumber              String?
  publicLiabilityInsurer String?
  publicLiabilityPolicyNumber String?
  publicLiabilityExpiresAt DateTime?
  coverageArea           String?
  suppliesTools          Boolean                   @default(false)
  suppliesMaterials      Boolean                   @default(false)
  crewMemberships        CrewMember[]

  @@index([active, accessLevel])
  @@index([lastName, firstName])
  @@index([email])
}

model Crew {
  id                  Int          @id @default(autoincrement())
  slug                String       @unique
  name                String
  dayRate             Float
  durationMultiplier  Float        @default(1)
  skillLevel          String       @default("standard")
  suitableJobTypes    String[]     @default([])
  technicalSpecialist Boolean      @default(false)
  summary             String?
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  members             CrewMember[]

  @@index([active, name])
}

model CrewMember {
  id       Int    @id @default(autoincrement())
  crewId   Int
  workerId Int
  crew     Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([crewId, workerId])
  @@index([workerId])
}

model WebAuthnCredential {
  id         String  @id
  workerId   Int
  publicKey  String
  counter    Int
  deviceType String
  backedUp   Boolean
  transports String?
  worker     Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
}

model WorkerCompany {
  id        Int     @id @default(autoincrement())
  workerId  Int
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  worker    Worker  @relation(fields: [workerId], references: [id])

  @@unique([workerId, companyId])
  @@index([companyId])
}

model Customer {
  id            Int            @id @default(autoincrement())
  name          String
  phone         String?
  email         String?
  address       String?
  postcode      String?
  notes         String?
  createdAt     DateTime       @default(now())
  archived      Boolean        @default(false)
  inboxMessages InboxMessage[]
  jobs          Job[]
  quotes        Quote[]

  @@index([archived, createdAt])
  @@index([name])
  @@index([postcode])
}

model Job {
  id                        Int             @id @default(autoincrement())
  title                     String
  customerId                Int
  address                   String
  notes                     String?
  visitDate                 DateTime?
  startTime                 String?
  fixedSchedule             Boolean         @default(false)
  durationMinutes           Int?
  status                    String          @default("unscheduled")
  createdAt                 DateTime        @default(now())
  jobType                   String          @default("Quote")
  arrivedAt                 DateTime?
  finishedAt                DateTime?
  overrunMins               Int             @default(0)
  pausedAt                  DateTime?
  pausedMinutes             Int             @default(0)
  paymentNotes              String?
  paymentStatus             String?
  isRegularMaintenance      Boolean         @default(false)
  maintenanceFrequency      String?
  maintenanceFrequencyUnit  String?
  maintenanceFrequencyWeeks Int?
  preferredDay              String?
  preferredTimeBand         String?
  timePreferenceMode        String?
  visitPattern              String?
  archivedAt                DateTime?
  archivedByWorkerId        Int?
  cancelledAt               DateTime?
  cancelledByWorkerId       Int?
  cancellationReason        String?
  chasMessages              ChasMessage[]
  inboxMessages             InboxMessage[]
  customer                  Customer        @relation(fields: [customerId], references: [id])
  assignments               JobAssignment[]
  jobNotes                  JobNote[]
  photos                    JobPhoto[]
  auditLogs                 JobAuditLog[]
  notifications             Notification[]
  activityLogs              ActivityLog[]
  quotes                    Quote[]

  @@index([customerId])
  @@index([status, createdAt])
  @@index([visitDate, status])
  @@index([customerId, visitDate])
  @@index([jobType, visitDate])
  @@index([createdAt])
}

model JobAssignment {
  id        Int      @id @default(autoincrement())
  jobId     Int
  workerId  Int
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([jobId, workerId])
  @@index([workerId, createdAt])
  @@index([jobId, createdAt])
}

model JobNote {
  id                Int      @id @default(autoincrement())
  jobId             Int
  note              String
  createdAt         DateTime @default(now())
  createdByWorkerId Int?
  worker            Worker?  @relation(fields: [createdByWorkerId], references: [id])
  job               Job      @relation(fields: [jobId], references: [id])

  @@index([jobId, createdAt])
  @@index([createdByWorkerId, createdAt])
}

model JobPhoto {
  id                 Int      @id @default(autoincrement())
  jobId              Int
  uploadedByWorkerId Int?
  label              String?
  imageUrl           String
  createdAt          DateTime @default(now())
  job                Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  uploadedByWorker   Worker?  @relation(fields: [uploadedByWorkerId], references: [id])

  @@index([jobId, createdAt])
  @@index([uploadedByWorkerId, createdAt])
}

model ChasMessage {
  id                   Int      @id @default(autoincrement())
  company              String
  worker               String
  workerId             Int?
  jobId                Int?
  question             String
  answer               String
  imageDataUrl         String?
  createdAt            DateTime @default(now())
  confidence           Float?
  conversationId       String?
  customerAddress      String?
  customerEmail        String?
  customerName         String?
  customerPhone        String?
  conversation         ChasConversation? @relation(fields: [conversationId], references: [id])
  job                  Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  workerRecord         Worker?  @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([jobId, createdAt])
  @@index([workerId, createdAt])
}

model ChasConversation {
  id           String        @id @default(cuid())
  company      String
  workerId     Int?
  jobId        Int?
  customerName String?
  title        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     ChasMessage[]

  @@index([company, updatedAt])
  @@index([workerId, updatedAt])
  @@index([jobId, updatedAt])
}

model TimeOffRequest {
  id           Int      @id @default(autoincrement())
  workerId     Int
  startDate    DateTime
  endDate      DateTime
  type         String
  status       String   @default("requested")
  notes        String?
  createdAt    DateTime @default(now())
  worker       Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, startDate])
  @@index([status, startDate])
}

model WorkerAvailabilityBlock {
  id        Int      @id @default(autoincrement())
  workerId  Int
  startAt   DateTime
  endAt     DateTime
  reason    String?
  source    String   @default("manual")
  createdAt DateTime @default(now())
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, startAt])
  @@index([startAt, endAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  jobId     Int
  type      String
  scheduledFor DateTime
  sentAt    DateTime?
  cancelledAt DateTime?
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, scheduledFor])
  @@index([sentAt, scheduledFor])
}

model JobAuditLog {
  id         Int      @id @default(autoincrement())
  jobId      Int
  action     String
  beforeJson String?
  afterJson  String?
  createdAt  DateTime @default(now())
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  workerId  Int?
  jobId     Int?
  action    String
  details   String?
  createdAt DateTime @default(now())
  worker    Worker?  @relation(fields: [workerId], references: [id], onDelete: SetNull)
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([workerId, createdAt])
  @@index([jobId, createdAt])
}

model InboxMessage {
  id             Int      @id @default(autoincrement())
  customerId     Int?
  jobId          Int?
  channel        String
  externalId     String?
  subject        String?
  body           String
  senderName     String?
  senderAddress  String?
  receivedAt     DateTime
  createdAt      DateTime @default(now())
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  job            Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([customerId, receivedAt])
  @@index([jobId, receivedAt])
  @@index([channel, receivedAt])
}

model Quote {
  id                Int       @id @default(autoincrement())
  customerId        Int
  jobId             Int?
  status            String    @default("draft")
  title             String
  description       String?
  total             Float?
  depositPercent    Float?
  depositAmount     Float?
  estimatedDays     Float?
  estimatedTeamSize Int?
  internalNotes     String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  customer          Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job               Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  items             QuoteItem[]

  @@index([customerId, createdAt])
  @@index([jobId])
  @@index([status, createdAt])
}

model QuoteItem {
  id          Int      @id @default(autoincrement())
  quoteId     Int
  description String
  quantity    Float?
  unit        String?
  unitPrice   Float?
  total       Float?
  sortOrder   Int      @default(0)
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, sortOrder])
}
